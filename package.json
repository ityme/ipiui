{
  "name": "ipiui",
  "version": "0.1.0",
  "description": "Pi extension for a compact status row and shared terminal pane titles",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "license": "GPL-3.0-only",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/styles-gallery.html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityme/ipiui.git"
  },
  "homepage": "https://github.com/ityme/ipiui#readme",
  "bugs": {
    "url": "https://github.com/ityme/ipiui/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
